# Database Configuration
POSTGRES_USER=greenxchange
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=greenxchange
# Full connection string used directly by the backend. Required — there is no
# hardcoded fallback. Example (must match the POSTGRES_* values above):
# DATABASE_URL=postgresql://greenxchange:replace_with_secure_password@localhost:5432/greenxchange
DATABASE_URL=

# Backend Configuration
# Required. No default is hardcoded in source — the app refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# HS256 (default, uses SECRET_KEY above) or RS256 (uses the JWT_*_KEY_B64 pair below).
# If RS256 is selected, both JWT key vars below are mandatory or the app will not start —
# it will never silently fall back to HS256.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Only required when ALGORITHM=RS256. Generate with: python backend/scripts/generate_keys.py
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
MINIMUM_GROWTH_UPDATE_INTERVAL_HOURS=24
CV_MODEL_PATH=assets/models/plant_cv_v1.pkl
OPENAI_API_KEY=your_openai_api_key_here

# Email (SMTP) — required only if you want real outbound email locally.
# Left unset, sending gracefully falls back to Resend (if configured) or a logged failure.
SMTP_USER=
SMTP_PASSWORD=

# Publicly accessible frontend origin (no trailing slash). Used to build the links
# sent in verification/password-reset/org-payment-request emails. Must be reachable
# by whoever receives the email — do NOT use localhost or a private LAN IP here
# except when testing entirely on one machine. Production value:
FRONTEND_URL=https://greenxchange-frontend.onrender.com

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_with_secure_password
MINIO_KMS_SECRET_KEY=my-minio-key:32byteslongsecretkeyforsse12345
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
# Browser-reachable origin for MinIO media (MINIO_ENDPOINT above is an internal
# hostname). Leave unset to keep the http://localhost:9000 default.
MINIO_PUBLIC_URL=

# NextJS Configuration
NEXT_PUBLIC_API_URL=/api

# Groq LLM API Keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_CARE_API_KEY=your_groq_care_api_key_here

# Default account seeding — no passwords are hardcoded in source.
# Backend auto-seed (app/main.py, runs on every boot): an org account is only
# created if its password var below is set; already-created accounts are never
# touched. backend/scripts/seed_demo_data.py (manual dev script) uses the same
# vars, and falls back to auto-generating+printing a password if left unset.
SEED_TESTORG_PASSWORD=
SEED_GOV_NURSERY_DELHI_PASSWORD=
SEED_ECOCARE_PARTNER_PASSWORD=
# Only used by backend/scripts/seed_demo_data.py.
SEED_ADMIN_PASSWORD=
SEED_DEMO_USER_PASSWORD=

# Shared secret for POST /api/environment/hardware telemetry ingestion.
# Left unset, the endpoint stays open (unauthenticated) for backward compatibility
# with existing devices. Set this AND configure the same key on your device's
# X-Hardware-Api-Key header to require it.
HARDWARE_API_KEY=


